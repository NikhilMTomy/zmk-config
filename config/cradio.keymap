#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Home row mods macro
#define HRML(k1,k2,k3,k4) &ht LGUI k1  &ht LALT k2  &ht LCTRL k3  &ht LSHIFT k4
#define HRMR(k1,k2,k3,k4) &ht RSHIFT k1  &ht RCTRL k2  &ht RALT k3  &ht RGUI k4

#define DEFAULT 0
#define NAV 1
#define NUM 2
#define MEDIA 3
#define SYM 4
#define FUN 5

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NUM MEDIA>;
            then-layer = <FUN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
        //╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
        //│ Q             │ W             │ E             │ R             │ T             │   │ Y             │ U             │ I             │ O             │ P             │
            &kp Q           &kp W           &kp E           &kp R           &kp T               &kp Y           &kp U           &kp I           &kp O           &kp P
        //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        //│ A             │  S            │ D             │ F             │ G             │   │ H             │ J             │ K             │ L             │ ; :           │
            HRML(A,          S,             D,              F)              &kp G                &kp H          HRMR(J,         K,              L,              SEMI)
        //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        //│ Z             │ X             │ C             │ V             │ B             │   │ N             │ M             │ , <           │ . >           │ / ?           │
            &kp Z           &kp X           &kp C           &kp V           &kp B               &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH
        //╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯
        //                                                │               │               │   │               │               │
                                                            &mo NAV         &mo NUM             &mo MEDIA       &mo SYM
        //                                                ╰───────────────┴───────────────╯   ╰───────────────┴───────────────╯
            >;
        };

        nav_layer {
            bindings = <
        //╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
        //│               │               │               │               │               │   │               │ HOME          │ END           │ PAGE UP       │ PAGE DN       │
            &none           &none           &none           &none           &none               &none           &kp HOME        &kp END         &kp PG_UP       &kp PG_DN
        //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        //│               │               │               │               │ CAPS          │   │ LEFT          │ DOWN          │ UP            │ RIGHT         │               │
            &kp LGUI        &kp LALT        &kp LCTRL       &kp LSHIFT      &caps_word          &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &none
        //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        //│               │               │               │               │               │   │ DELETE        │ PASTE         │ COPY          │ CUT           │ INS           │
            &none           &none           &none           &none           &none               &kp DEL         &kp K_PASTE     &kp K_COPY      &kp K_CUT       &kp INS
        //╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯
        //                                                │               │               │   │               │               │
                                                            &none           &none               &kp ENTER       &kp BSPC
        //                                                ╰───────────────┴───────────────╯   ╰───────────────┴───────────────╯
            >;
        };

        num_layer {
            bindings = <
        //╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
        //│ !             │ @             │ #             │ $             │ %             │   │               │ 7             │ 8             │ 9             │               │
            &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT           &none           &kp N7          &kp N8          &kp N9          &none
        //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        //│               │               │               │               │               │   │ 0             │ 4             │ 5             │ 6             │               │
            &kp LGUI        &kp LALT        &kp LCTRL       &kp LSHIFT      &none               &kp N0          &kp N4          &kp N5          &kp N6          &none
        //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        //│ 1             │ 2             │ 3             │ 4             │ 5             │   │               │ 1             │ 2             │ 3             │               │
            &kp N1          &kp N2          &kp N3          &kp N4          &kp N5              &none           &kp N1          &kp N2          &kp N3          &none
        //╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯
        //                                                │               │               │   │               │               │
                                                            &none           &none               &mo MEDIA       &none
        //                                                ╰───────────────┴───────────────╯   ╰───────────────┴───────────────╯
            >;
        };

        media_layer {
            bindings = <
        //╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
        //│ PREV          │ PLAY PAUSE    │ NEXT          │ VOL DOWN      │ VOL UP        │   │ ^             │ &             │ *             │ (             │ )             │
            &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp C_VOL_DN    &kp C_VOL_UP        &kp CARET       &kp AMPS        &kp ASTRK       &kp LPAR        &kp RPAR
        //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        //│ 1             │ 2             │ 3             │ 4             │ 5             │   │               │               │               │               │               │
            &none           &none           &none           &none           &none               &none           &kp RSHIFT      &kp RCTRL       &kp RALT        &kp RGUI
        //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        //│               │               │               │               │               │   │               │               │               │               │               │
            &none           &none           &none           &none           &none               &kp N6          &kp N7          &kp N8          &kp N9          &kp N0
        //╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯
        //                                                │               │               │   │               │               │
                                                            &none           &mo NUM             &none           &none
        //                                                ╰───────────────┴───────────────╯   ╰───────────────┴───────────────╯
            >;
        };

        sym_layer {
            bindings = <
        //╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
        //│               │ ` ~           │ (             │ )             │ ; :           │   │ ^             │ &             │ *             │ (             │ )             │
            &none           &kp GRAVE       &kp LPAR        &kp RPAR        &kp SEMI            &kp CARET       &kp AMPS        &kp ASTRK       &kp LPAR        &kp RPAR
        //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        //│ 1             │ - _           │ [             │ ]             │ \ |           │   │               │               │               │               │               │
            &none           &kp MINUS       &kp LBKT        &kp LBKT        &kp BSLH            &none           &kp RSHIFT      &kp RCTRL       &kp RALT        &kp RGUI
        //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        //│               │ = +           │ {             │ }             │ ESCAPE        │   │               │               │               │               │               │
            &none           &kp EQUAL       &kp LBRC        &kp RBRC        &kp ESC             &kp N6          &kp N7          &kp N8          &kp N9          &kp N0
        //╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯
        //                                                │               │               │   │               │               │
                                                            &kp SPACE       &kp TAB             &none           &none
        //                                                ╰───────────────┴───────────────╯   ╰───────────────┴───────────────╯
            >;
        };

        fun_layer {
            bindings = <
        //╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
        //│ RESET         │ PROFILE 0     │ PROFILE 1     │ PROFILE 2     │ CLEAR BT      │   │               │               │               │ ZMK Studio    │ RESET         │
           &sys_reset       &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_CLR          &none           &none           &none           &studio_unlock  &sys_reset
        //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        //│ BOOTLOADER    │               │               │               │ F11           │   │ F12           │               │               │               │ BOOTLOADER    │
            &bootloader     &none           &none           &none           &kp F11             &kp F12         &none           &none           &none           &bootloader
        //├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        //│ F1            │ F2            │ F3            │ F4            │ F5            │   │ F6            │ F7            │ F8            │ F9            │ F10           │
            &kp F1          &kp F2          &kp F3          &kp F4          &kp F5              &kp F6          &kp F7          &kp F8          &kp F9          &kp F10
        //╰───────────────┴───────────────┴───────────────┼───────────────┼───────────────┤   ├───────────────┼───────────────┼───────────────┴───────────────┴───────────────╯
        //                                                │               │               │   │               │               │
                                                            &none           &none               &none           &none 
        //                                                ╰───────────────┴───────────────╯   ╰───────────────┴───────────────╯
            >;
        };

        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };
    };
};
